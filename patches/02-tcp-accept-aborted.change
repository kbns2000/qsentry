        /* Temporary error -- retry.
         * qnx: so is a connection that the peer has reset while it waited in
         * the listen queue: a BSD network stack takes it out of the queue and
         * reports ECONNABORTED. EAGAIN/EWOULDBLOCK means that there was
         * nothing to accept. Neither is a reason to close the listen socket. */
        if(UA_ERRNO == UA_INTERRUPTED || UA_ERRNO == ECONNABORTED ||
           UA_ERRNO == UA_AGAIN || UA_ERRNO == UA_WOULDBLOCK)
            return;
