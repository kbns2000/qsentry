# open62541-qnx change: tcp-accept-aborted
# SPDX-License-Identifier: MPL-2.0
#
# title: Keep the listen socket when accept() finds an aborted connection
# file: open62541.c
# upstream: arch/eventloop_posix_tcp.c
# test: robust.aborted_connect
#
# When accept() fails with anything but EINTR, the listen socket is closed
# and the server accepts no connection on it any more until it is restarted.
#
# A connection that the peer resets while it waits in the listen queue is such
# a failure on a BSD network stack: the connection stays in the queue, and
# accept() takes it out, closes it and fails with ECONNABORTED. Linux hands
# out the dead connection instead, so the problem does not show there. One
# TCP handshake followed by a reset is all that a peer needs to send.
# EAGAIN/EWOULDBLOCK (nothing to accept on the non-blocking listen socket) is
# no reason to close it either.
#
# EMFILE, ENFILE, ENOBUFS and ENOMEM still close the listen socket, as in the
# release: the connection stays in the queue then, and returning would make
# the EventLoop spin on the readable listen socket.
#
@@ hunk
<<<<<<< open62541 v1.4.22
        /* Temporary error -- retry */
        if(UA_ERRNO == UA_INTERRUPTED)
            return;
