        /* Temporary error -- retry.
         * qnx: so is a connection that the peer has reset while it waited in
         * the listen queue. A BSD network stack reports it as ECONNABORTED, or
         * it has removed it already and the non-blocking accept() finds
         * nothing. Neither is a reason to close the listen socket. */
        if(UA_ERRNO == UA_INTERRUPTED || UA_ERRNO == ECONNABORTED ||
           UA_ERRNO == UA_AGAIN || UA_ERRNO == UA_WOULDBLOCK)
            return;
