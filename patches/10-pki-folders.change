#ifdef __linux__
#include <dirent.h>

static int UA_Certificate_Filter_der_pem (const struct dirent * entry) {
=======
#if defined(__linux__) || defined(__QNXNTO__) /* qnx: needs only scandir() */
#include <dirent.h>
#include <limits.h>

/* qnx: scandir() allocates the list and every entry of it. The release
 * never frees them, so every verification loses that memory. */
static void
UA_Certificate_freeDirList (struct dirent *** dirlist, int count) {
    while (count > 0)
        free ((*dirlist)[--count]);
    free (*dirlist);
    *dirlist = NULL;
}

static int UA_Certificate_Filter_der_pem (const struct dirent * entry) {
