# open62541-qnx change: pki-folders
# SPDX-License-Identifier: MPL-2.0
#
# title: Certificate folders (trust list, issuers, revocation lists) on QNX
# file: open62541.c
# upstream: plugins/crypto/openssl/ua_pki_openssl.c plugins/include/open62541/plugin/pki_default.h plugins/ua_config_json.c
# test: security.certfolder.trusted security.certfolder.added security.certfolder.removed security.certfolder.log security.certfolder.long_name
#
# UA_CertificateVerification_CertFolders() reads the trusted certificates,
# the issuer certificates and the revocation lists from three directories,
# again for every certificate that is verified. A certificate can so be
# trusted or withdrawn while the server runs. The release has the function
# "for Linux only so far". It needs nothing but scandir(), which QNX has.
#
# Three faults of the function, which it has on Linux as well, are fixed
# with it:
# - The directory lists that scandir() returns were never freed. The memory
#   was lost with every verification.
# - Its context keeps a pointer to the structure it was set up in, for its
#   log messages. UA_Server_newWithConfig() moves the configuration into the
#   server and zeroes that structure, so the messages of the trust list were
#   lost. After UA_Server_newFromFile(), whose configuration file can name
#   the folders, the pointer refers to a stack frame that no longer exists.
#   Every verification now points it at the structure in use.
# - The folder names are copied into char[PATH_MAX] without a length check:
#   a longer name overflowed the stack with every verification. It is now
#   refused.
#
@@ hunk open62541.h
<<<<<<< open62541 v1.4.10
#ifdef __linux__ /* Linux only so far */

#ifdef UA_ENABLE_CERT_REJECTED_DIR
UA_EXPORT UA_StatusCode
UA_CertificateVerification_CertFolders(UA_CertificateVerification *cv,
=======
#if defined(__linux__) || defined(__QNXNTO__) /* qnx: needs only scandir() */

#ifdef UA_ENABLE_CERT_REJECTED_DIR
UA_EXPORT UA_StatusCode
UA_CertificateVerification_CertFolders(UA_CertificateVerification *cv,
>>>>>>> open62541-qnx
