    /* Receive has failed */
    if(ret <= 0) {
        /* qnx: a datagram without payload is a valid datagram, and anybody can
         * send one: recvfrom() returns 0 for it and does not set errno. It is
         * no reason to close the socket, and neither is a wake-up without a
         * datagram. */
        if(ret == 0 || UA_ERRNO == UA_INTERRUPTED ||
           UA_ERRNO == UA_AGAIN || UA_ERRNO == UA_WOULDBLOCK)
            return;

