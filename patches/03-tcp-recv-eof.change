    /* Receive has failed */
    if(ret <= 0) {
        /* qnx: recv() == 0 means that the peer has closed, and errno is not
         * set then. Look at errno only after a failure: an EAGAIN left over
         * from an earlier send() would hide the end of the connection and the
         * EventLoop would spin on the readable socket. */
        if(ret < 0 &&
           (UA_ERRNO == UA_INTERRUPTED ||
            UA_ERRNO == UA_WOULDBLOCK ||
            UA_ERRNO == UA_AGAIN))
            return; /* Temporary error on an non-blocking socket */
        if(ret == 0)
            errno = 0; /* qnx: no stale errno in the log line below */
>>>>>>> open62541-qnx
