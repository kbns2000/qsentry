    /* Clear if the plugin is already initialized.
     * qnx: clear() zeroes *cv, the logger included, and the new context
     * takes its logger from cv: keep it, or the PKI logs nothing */
    const UA_Logger *logging = cv->logging;
    if(cv->clear)
        cv->clear(cv);
    cv->logging = logging;
