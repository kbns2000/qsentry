# open62541-qnx change: pki-folders
# SPDX-License-Identifier: MPL-2.0
#
# title: Certificate folders (trust list, issuers, revocation lists) on QNX
# file: open62541.c
# upstream: plugins/crypto/openssl/ua_pki_openssl.c plugins/include/open62541/plugin/pki_default.h plugins/ua_config_json.c
# test: security.certfolder.trusted security.certfolder.added security.certfolder.removed security.certfolder.log security.certfolder.long_name
#
# UA_CertificateVerification_CertFolders() reads the trusted certificates,
# the issuer certificates and the revocation lists from three directories,
# again for every certificate that is verified. A certificate can so be
# trusted or withdrawn while the server runs. The release has the function
# "for Linux only so far". It needs nothing but scandir(), which QNX has.
#
# Two faults of the function come along with it, on Linux as well; the change
# fixes them for the folders on QNX:
#
# - The reload copies the folder names into char[PATH_MAX] without a length
#   check, so a longer name overflows the stack with every verification. The
#   change refuses such a name.
# - Called on a PKI that is already set up (the default server configuration
#   sets one up), the function clears it first. The clear function zeroes the
#   whole structure, logger included, and the new context takes its logger
#   from there: NULL. Every message of the PKI is lost, among them "Failed to
#   load the certificate file" for a bad file in the trust folder. The change
#   keeps the logger.
#
@@ hunk open62541.h
<<<<<<< open62541 v1.4.22
