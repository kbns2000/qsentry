#else /* O6Q_EVENTLOOP_POLL */

/* qnx: UA_EventLoopPOSIX_pollFDs with ppoll() instead of select().
 *
 * select() cannot wait on a descriptor whose number is FD_SETSIZE or more,
 * and FD_SET() with such a number writes outside of the fd_set. The version
 * above does not check for that, and a process may open more descriptors
 * than FD_SETSIZE.
 *
 * ppoll() takes an array of descriptors, so the number of a descriptor does
 * not matter, and the timeout keeps its resolution. Where this version
 * behaves differently from the select() version, it behaves like the epoll
 * version:
 *  - Without a registered descriptor it waits for the timeout instead of
 *    returning at once. A client that iterates while it is disconnected no
 *    longer spins.
 *  - An error or a hang-up is reported (UA_FDEVENT_ERR) also for a descriptor
 *    that listens for nothing.
 * A signal that interrupts the wait is not logged as an error. */

#define O6Q_POLL_ONSTACK 128

UA_StatusCode
UA_EventLoopPOSIX_pollFDs(UA_EventLoopPOSIX *el, UA_DateTime listenTimeout) {
    UA_assert(listenTimeout >= 0);
    UA_LOCK_ASSERT(&el->elMutex, 1);

    /* Copy the registered descriptors. The copy is used while the lock is
     * released, when another thread may register or deregister. */
    struct pollfd pfdsStack[O6Q_POLL_ONSTACK];
    UA_RegisteredFD *rfdsStack[O6Q_POLL_ONSTACK];
    struct pollfd *pfds = pfdsStack;
    UA_RegisteredFD **rfds = rfdsStack;
    void *heap = NULL;
    size_t n = el->fdsSize;
    if(n > O6Q_POLL_ONSTACK) {
        heap = UA_malloc(n * (sizeof(UA_RegisteredFD*) + sizeof(struct pollfd)));
        if(heap) {
            rfds = (UA_RegisteredFD**)heap;
            pfds = (struct pollfd*)(rfds + n);
        } else {
            /* Do not return at once (the caller would spin): wait on the
             * first descriptors, the others when memory is back */
            UA_LOG_WARNING(el->eventLoop.logger, UA_LOGCATEGORY_EVENTLOOP,
                           "Out of memory: waiting on %u of %u descriptors",
                           (unsigned)O6Q_POLL_ONSTACK, (unsigned)n);
            n = O6Q_POLL_ONSTACK;
        }
    }
    for(size_t i = 0; i < n; i++) {
        UA_RegisteredFD *rfd = el->fds[i];
        short events = 0;
        if(rfd->listenEvents & UA_FDEVENT_IN)
            events = (short)(events | POLLIN);
        if(rfd->listenEvents & UA_FDEVENT_OUT)
            events = (short)(events | POLLOUT);
        rfds[i] = rfd;
        pfds[i].fd = rfd->fd;
        pfds[i].events = events;
        pfds[i].revents = 0;
    }

    /* UA_DateTime counts in units of 100 ns */
    struct timespec timeout;
    timeout.tv_sec = (time_t)(listenTimeout / UA_DATETIME_SEC);
    timeout.tv_nsec = (long)((listenTimeout % UA_DATETIME_SEC) * 100);

    UA_UNLOCK(&el->elMutex);
    int pollStatus = ppoll(pfds, (nfds_t)n, &timeout, NULL);
    UA_LOCK(&el->elMutex);
    if(pollStatus < 0) {
        /* We will retry. A signal that interrupts the wait is no error. */
        if(UA_ERRNO == UA_INTERRUPTED) {
            errno = 0;
        } else {
            UA_LOG_SOCKET_ERRNO_WRAP(
                UA_LOG_WARNING(el->eventLoop.logger, UA_LOGCATEGORY_EVENTLOOP,
                               "Error during ppoll: %s", errno_str));
        }
    }

    /* Go through the registered descriptors as the select() version does. A
     * callback may deregister its own descriptor, upon which the last entry
     * moves into its slot, and it may register new ones. An entry is matched
     * with the copy by its address and its descriptor; what was registered
     * after the copy was taken has no event yet. */
    for(size_t i = 0; pollStatus > 0 && i < el->fdsSize; i++) {
        UA_RegisteredFD *rfd = el->fds[i];

        /* The rfd is already registered for removal. Don't process incoming
         * events any longer. */
        if(rfd->dc.callback)
            continue;

        /* Find the entry in the copy. Usually it has the same index. */
        size_t j = i;
        if(j >= n || rfds[j] != rfd) {
            for(j = 0; j < n; j++) {
                if(rfds[j] == rfd)
                    break;
            }
            if(j == n)
                continue;
        }
        short revents = pfds[j].revents;
        if(revents == 0 || pfds[j].fd != rfd->fd)
            continue;
        pfds[j].revents = 0; /* Every event is delivered once */

        /* One event per descriptor and iteration, in the order of the other
         * versions: readable before writable before error. POLLERR, POLLHUP
         * and POLLNVAL can come without having been asked for. */
        short event = UA_FDEVENT_ERR;
        if(revents & POLLIN)
            event = UA_FDEVENT_IN;
        else if(revents & POLLOUT)
            event = UA_FDEVENT_OUT;

        UA_LOG_DEBUG(el->eventLoop.logger, UA_LOGCATEGORY_EVENTLOOP,
                     "Processing event %u on fd %u", (unsigned)event,
                     (unsigned)rfd->fd);

        /* Call the EventSource callback */
        rfd->eventSourceCB(rfd->es, rfd, event);

        /* The fd has removed itself */
        if(i >= el->fdsSize || rfd != el->fds[i])
            i--;
    }

    if(heap)
        UA_free(heap);
    return UA_STATUSCODE_GOOD;
}

#endif /* O6Q_EVENTLOOP_POLL */

#endif /* !defined(UA_HAVE_EPOLL) */
