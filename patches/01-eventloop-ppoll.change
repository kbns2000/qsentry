/* qnx: which function the EventLoop waits in.
 *   O6Q_EVENTLOOP_POLL    ppoll(), the default on QNX
 *   O6Q_EVENTLOOP_SELECT  select(), as in the release
 * Both are in eventloop_posix_select.c. On Linux either of them replaces
 * epoll, which makes it possible to test this code there. Without epoll the
 * interrupt manager uses a self-pipe instead of signalfd (as on QNX), and a
 * process can then have only one of them. */
#if !defined(O6Q_EVENTLOOP_POLL) && !defined(O6Q_EVENTLOOP_SELECT) && \
    defined(__QNXNTO__)
# define O6Q_EVENTLOOP_POLL 1
#endif

/* epoll_pwait returns bogus data with the tc compiler */
#if defined(__linux__) && !defined(__TINYC__) && \
    !defined(O6Q_EVENTLOOP_POLL) && !defined(O6Q_EVENTLOOP_SELECT)
# define UA_HAVE_EPOLL
