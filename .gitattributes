# Windows command files need CRLF; everything else stays LF on every host
# (the QNX shell does not accept CR).
*.cmd text eol=crlf
*.bat text eol=crlf
*.custom text eol=lf
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.mp4 binary
*.png binary
# raw QEMU console logs: kept byte for byte (the guest prints stray CRs)
results/runs/**/serial.log -text
