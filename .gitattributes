# Windows command files need CRLF; everything else stays LF on every host
# (the QNX shell does not accept CR, and scripts/port.py compares texts).
*.cmd text eol=crlf
*.bat text eol=crlf
*.custom text eol=lf
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
*.change text eol=lf
*.yml text eol=lf
CMakeLists.txt text eol=lf
patches/series text eol=lf
patches/LICENSE-MPL-2.0 text eol=lf
*.log text eol=lf
*.der binary
*.mp4 binary
*.png binary
# raw QEMU console logs: kept byte for byte (the guest prints stray CRs)
results/runs/**/serial.log -text
